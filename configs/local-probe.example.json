{
  "schema_version": "local-probe.config.v1",
  "roots": [
    {
      "id": "project",
      "path": "D:/replace/with/an/absolute/project/path",
      "deny_patterns": [".env", ".env.*", "secrets/**"],
      "ignore_patterns": [".git/**", "node_modules/**", "vendor/**", "*.tmp"]
    }
  ],
  "profiles": [
    {
      "id": "read_only",
      "roots": ["project"],
      "tools": [
        "server_info",
        "ping",
        "read_file",
        "batch_read",
        "list_directory",
        "find_files",
        "search_text"
      ],
      "deny_patterns": [],
      "ignore_patterns": [],
      "read_only": true
    }
  ],
  "connections": [
    {
      "id": "local",
      "label": "local read-only MCP",
      "profile_id": "read_only",
      "credential_ref": "local_token",
      "enabled": true
    }
  ],
  "credentials": [
    {
      "id": "local_token",
      "kind": "local_bearer"
    }
  ]
}
